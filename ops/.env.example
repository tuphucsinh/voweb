# Generate secrets on the Pi: openssl rand -hex 32
POSTGRES_DB=vorigin
POSTGRES_USER=vorigin
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
DIRECTUS_SECRET=CHANGE_ME_LONG_RANDOM
DIRECTUS_ADMIN_EMAIL=admin@vorigin.vn
DIRECTUS_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM
DIRECTUS_IMAGE=directus/directus:11

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
IP_HASH_SALT=CHANGE_ME_LONG_RANDOM

# Optional: a Directus static token limited to CREATE on leads only.
DIRECTUS_LEAD_TOKEN=
# Optional webhook for notification/automation.
LEAD_WEBHOOK_URL=

# Optional CMS sync token for build scripts, should have read-only access to published content.
DIRECTUS_READ_TOKEN=
